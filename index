<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ranking Natación - Dashboard</title>
  <style>
    :root {
      --excel-header-bg: #1f4e79;
      --excel-btn-bg: #b4c6e7;
      --excel-btn-active: #2f5597;
      --excel-border: #8ea9db;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f2f2f2;
      margin: 20px;
      color: #333;
    }

    .slicers-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 15px;
      margin-bottom: 25px;
      background: #ffffff;
      padding: 15px;
      border: 1px solid #ccc;
      border-radius: 4px;
    }

    .slicer-group {
      border: 1px solid var(--excel-border);
      border-radius: 4px;
      background: #fafafa;
      overflow: hidden;
    }

    .slicer-title {
      background-color: #e9eef4;
      padding: 6px 10px;
      font-weight: bold;
      font-size: 13px;
      border-bottom: 1px solid var(--excel-border);
      color: #1f4e79;
    }

    .slicer-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      padding: 8px;
      max-height: 160px;
      overflow-y: auto;
    }

    .btn-slicer {
      background-color: var(--excel-btn-bg);
      border: 1px solid #8ea9db;
      color: #000;
      padding: 6px 10px;
      font-size: 11px;
      cursor: pointer;
      border-radius: 2px;
      flex: 1 1 auto;
      text-align: center;
      transition: all 0.1s ease;
    }

    .btn-slicer:hover {
      background-color: #8ea9db;
    }

    .btn-slicer.active {
      background-color: var(--excel-btn-active);
      color: #ffffff;
      font-weight: bold;
    }

    /* Tabla */
    .table-container {
      overflow-x: auto;
      background: #fff;
      border: 1px solid #ccc;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }

    th {
      background-color: var(--excel-header-bg);
      color: white;
      padding: 8px;
      text-align: left;
      font-weight: 600;
      border: 1px solid #103356;
    }

    td {
      padding: 6px 8px;
      border: 1px solid #e0e0e0;
    }

    tr:nth-child(even) {
      background-color: #f9fbfd;
    }

    tr:hover {
      background-color: #edf2f8;
    }
  </style>
</head>
<body>

  <h2>Dashboard de Ranking y Resultados</h2>

  <!-- Segmentadores (Slicers) -->
  <div class="slicers-container">
    <div class="slicer-group">
      <div class="slicer-title">Categoría</div>
      <div class="slicer-buttons" id="slicer-categoria"></div>
    </div>
    <div class="slicer-group">
      <div class="slicer-title">Liga</div>
      <div class="slicer-buttons" id="slicer-liga"></div>
    </div>
    <div class="slicer-group">
      <div class="slicer-title">Prueba</div>
      <div class="slicer-buttons" id="slicer-prueba"></div>
    </div>
  </div>

  <!-- Tabla de Datos -->
  <div class="table-container">
    <table id="ranking-table">
      <thead>
        <tr id="table-headers">
          <th>POSC.</th>
          <th>PRUEBA</th>
          <th>NADADOR</th>
          <th>Nac. (Año-mes)</th>
          <th>Tiempo</th>
          <th>P. WA</th>
          <th>Fecha Torneo</th>
          <th>LIGA</th>
          <th>CLUB</th>
          <th>Categoría</th>
          <th>Edad</th>
        </tr>
      </thead>
      <tbody id="table-body">
        <tr><td colspan="11">Cargando datos...</td></tr>
      </tbody>
    </table>
  </div>

  <script>
    const API_URL = "https://script.google.com/macros/s/AKfycbzLaW4Pnh9y3u72tMucf4pThol2Qd7jxb_A7V1O_NrHyEwmS_xKtiiOXEgChxP1ecbFaw/exec";
    let allData = [];
    let selectedFilters = {
      Categoría: null,
      LIGA: null,
      PRUEBA: null
    };

    async function loadData() {
      try {
        const res = await fetch(API_URL);
        allData = await res.json();
        buildSlicers();
        renderTable(allData);
      } catch (err) {
        document.getElementById('table-body').innerHTML = `<tr><td colspan="11">Error al cargar datos.</td></tr>`;
      }
    }

    function buildSlicers() {
      createSlicerButtons('Categoría', 'slicer-categoria');
      createSlicerButtons('LIGA', 'slicer-liga');
      createSlicerButtons('PRUEBA', 'slicer-prueba');
    }

    function createSlicerButtons(field, elementId) {
      const container = document.getElementById(elementId);
      const uniqueValues = [...new Set(allData.map(item => item[field]).filter(Boolean))].sort();
      
      container.innerHTML = `<button class="btn-slicer active" onclick="setFilter('${field}', null, this)">Todos</button>`;
      
      uniqueValues.forEach(val => {
        const btn = document.createElement('button');
        btn.className = 'btn-slicer';
        btn.innerText = val;
        btn.onclick = () => setFilter(field, val, btn);
        container.appendChild(btn);
      });
    }

    function setFilter(field, value, btnElement) {
      selectedFilters[field] = value;
      
      // Manejar estilo activo en botones
      const parent = btnElement.parentElement;
      parent.querySelectorAll('.btn-slicer').forEach(b => b.classList.remove('active'));
      btnElement.classList.add('active');

      applyFilters();
    }

    function applyFilters() {
      let filtered = allData.filter(row => {
        return (!selectedFilters.Categoría || row.Categoría === selectedFilters.Categoría) &&
               (!selectedFilters.LIGA || row.LIGA === selectedFilters.LIGA) &&
               (!selectedFilters.PRUEBA || row.PRUEBA === selectedFilters.PRUEBA);
      });
      renderTable(filtered);
    }

    function renderTable(data) {
      const tbody = document.getElementById('table-body');
      if (data.length === 0) {
        tbody.innerHTML = `<tr><td colspan="11">No se encontraron resultados.</td></tr>`;
        return;
      }

      tbody.innerHTML = data.map(row => `
        <tr>
          <td>${row['POSC.'] || ''}</td>
          <td>${row['PRUEBA'] || ''}</td>
          <td><b>${row['NADADOR'] || ''}</b></td>
          <td>${row['Nac. (Año-mes)'] || ''}</td>
          <td>${row['Tiempo'] || ''}</td>
          <td>${row['P. WA'] || row['P.WA'] || ''}</td>
          <td>${row['Fecha Torneo'] || ''}</td>
          <td>${row['LIGA'] || ''}</td>
          <td>${row['CLUB'] || ''}</td>
          <td>${row['Categoría'] || ''}</td>
          <td>${row['Edad'] || ''}</td>
        </tr>
      `).join('');
    }

    loadData();
  </script>
</body>
</html>
